NODE_ENV=development
PORT=5000
APP_NAME=CRM
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# MySQL 8 (docker-compose me ready hai: docker compose -f docker/docker-compose.yml up -d mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_db
DB_USER=crm_app
DB_PASSWORD=CrmApp@2026_Secure
DB_POOL_MAX=10
DB_SSL=false          # cloud MySQL (RDS etc.) par true
DB_LOGGING=false      # true = har SQL query log
# true = start par pending migrations chala do (sirf local dev). Production me `npm run migrate` alag chalao.
RUN_MIGRATIONS_ON_BOOT=true

REDIS_URL=

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# 64 hex chars (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=b4c90dd292c099a6da0b85fc6e81d79e2a7149e5de030ddf6b2ad8bb184e5370
ENCRYPTION_KEY=1bcc96c95491e03297bbd374cb3321ba401e48f2ffcbff9b8f197bef1c6473b3
COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Google login: Google Cloud Console se OAuth Web Client ID (khali = Google login band)
GOOGLE_CLIENT_ID=
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

SEED_ON_BOOT=true
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# Optional SMTP (khali ho to mail console log me print hoga)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CRM <no-reply@example.com>"

# Files (platform/files)
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_MB=10
FILE_URL_TTL_SECONDS=300
