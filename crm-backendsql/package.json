{
  "name": "crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Modular (platform + crm + hrms + erp) Express/MySQL (Sequelize) backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node --use-system-ca src/server.js",
    "dev": "nodemon --node-options=--use-system-ca src/server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint src",
    "test": "jest",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "test:db": "RUN_DB_TESTS=true jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.9.14",
    "otplib": "^12.0.1",
    "pino": "^9.2.0",
    "pino-http": "^10.2.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.1"
  }
}
