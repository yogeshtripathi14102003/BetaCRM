# ---- Backend ----
# Sirf BASE URL env me jaata hai (ye har environment me badalta hai).
# API ke paths (/auth/login, /crm/leads ...) code me hain: src/config/endpoints.js
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ---- App ----
NEXT_PUBLIC_APP_NAME=CRM

# Google login (khali = Google button nahi dikhega). Backend ke GOOGLE_CLIENT_ID wali hi value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# true = backend ke bina in-memory mock data se poora UI chalta hai (production build me hamesha off).
# Demo login: koi bhi email+password -> admin | counsellor@demo.com -> limited role | 2fa@demo.com -> 2FA | OTP/2FA code: 123456
NEXT_PUBLIC_USE_MOCKS=false

# NOTE: NEXT_PUBLIC_* browser me jaate hain (public). Yahan kabhi secret/password mat rakho.
